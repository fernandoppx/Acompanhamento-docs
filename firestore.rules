rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Candidate Validation
    function isValidCandidate(data) {
      return data.keys().hasAll(['name', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.status in ['Active', 'Archive'] &&
             (data.get('synthesis', '') is string && data.get('synthesis', '').size() <= 5000) &&
             (data.get('meetingLink', '') is string && data.get('meetingLink', '').size() <= 1000);
    }

    // Document Validation
    function isValidDocument(data) {
      return data.keys().hasAll(['type', 'status']) &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 200 &&
             data.status in ['SOLICITADO', 'ENVIADO'] &&
             (!data.keys().hasAny(['requestedDate']) || data.requestedDate == null || data.requestedDate is timestamp) &&
             (!data.keys().hasAny(['sentDate']) || data.sentDate == null || data.sentDate is timestamp);
    }

    match /candidates/{candidateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(candidateId) && isValidCandidate(incoming());
      allow update: if isSignedIn() && isValidCandidate(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'status', 'synthesis', 'meetingLink', 'updatedAt'])
      );
      allow delete: if isSignedIn();

      match /documents/{docId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(docId) && isValidDocument(incoming());
        allow update: if isSignedIn() && isValidDocument(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'requestedDate', 'sentDate', 'updatedAt'])
        );
        allow delete: if isSignedIn();
      }
    }
  }
}
