rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Candidate Validation
    function isValidCandidate(data) {
      return (data.get('name', '') is string) &&
             (data.get('status', 'Active') in ['Active', 'Archive']) &&
             (data.get('synthesis', '') is string) &&
             (data.get('meetingLink', '') is string) &&
             (data.get('paymentValue', '') is string) &&
             (data.get('boardStatus', null) == null || data.boardStatus is bool) &&
             (data.get('paymentStatus', null) == null || data.paymentStatus is bool) &&
             (data.get('paymentDate', null) == null || data.paymentDate is timestamp) &&
             (data.get('updatedAt', request.time) is timestamp);
    }

    // Document Validation
    function isValidDocument(data) {
      return (data.get('type', '') is string) &&
             (data.get('sentStatus', null) == null || data.sentStatus is bool) &&
             (data.get('returnedStatus', null) == null || data.returnedStatus is bool) &&
             (data.get('legalStatus', null) == null || data.legalStatus is bool) &&
             (data.get('sentDate', null) == null || data.sentDate is timestamp) &&
             (data.get('returnedDate', null) == null || data.returnedDate is timestamp) &&
             (data.get('legalDate', null) == null || data.legalDate is timestamp) &&
             (data.get('updatedAt', request.time) is timestamp);
    }

    match /candidates/{candidateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidCandidate(incoming());
      allow update: if isSignedIn() && isValidCandidate(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'status', 'synthesis', 'meetingLink', 
          'boardStatus', 'paymentDate', 'paymentValue', 'paymentStatus', 'updatedAt'
        ])
      );
      allow delete: if isSignedIn();

      match /documents/{docId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidDocument(incoming());
        allow update: if isSignedIn() && isValidDocument(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'sentDate', 'sentStatus', 'returnedDate', 'returnedStatus', 
            'legalDate', 'legalStatus', 'updatedAt'
          ])
        );
        allow delete: if isSignedIn();
      }
    }
  }
}
