{
  "entities": {
    "Candidate": {
      "title": "Candidate",
      "description": "A candidate for becoming a franchisee.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Candidate full name" },
        "synthesis": { "type": "string", "description": "Synthesis of the franchisee evaluation" },
        "meetingLink": { "type": "string", "description": "Link to the Fathom meeting" },
        "status": { "type": "string", "enum": ["Active", "Archive"], "description": "Overall candidate status" },
        "boardStatus": { "type": ["boolean", "null"] },
        "paymentDate": { "type": ["string", "null"], "format": "date-time" },
        "paymentValue": { "type": "string" },
        "paymentStatus": { "type": ["boolean", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "status"]
    },
    "Document": {
      "title": "Document",
      "description": "A document record for a candidate.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "Type/Name of the document" },
        "sentDate": { "type": ["string", "null"], "format": "date-time" },
        "sentStatus": { "type": ["boolean", "null"] },
        "returnedDate": { "type": ["string", "null"], "format": "date-time" },
        "returnedStatus": { "type": ["boolean", "null"] },
        "legalDate": { "type": ["string", "null"], "format": "date-time" },
        "legalStatus": { "type": ["boolean", "null"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type"]
    }
  },
  "firestore": {
    "/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Main candidate records"
    },
    "/candidates/{candidateId}/documents/{docId}": {
      "schema": "Document",
      "description": "Documents associated with a candidate"
    }
  }
}
